// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  User
  Admin
  Superadmin
  Supervisor
  Keuangan
}

enum IssueStatus {
  Waiting
  InProgress
  Resolved
}

enum StatusST {
  Belum_Diserahkan
  Diserahkan
}

enum AgreeState {
  Menunggu
  Disetujui
  Ditolak
}

enum CacahStatus {
  Belum_Cacah
  Selesai
}

enum NotificationType {
  SUBMIT_SPJ_CREATED
  SUBMIT_SPJ_APPROVED
  SUBMIT_SPJ_REJECTED
  JOB_LETTER_APPROVED
  JOB_LETTER_REJECTED
  ISSUE_COMMENT_ADDED
  CONTENT_ISSUE_CREATED
  SUBSURVEY_START_SOON
  SUBSURVEY_END_SOON
}

enum TargetType {
  SUBMIT_SPJ
  JOB_LETTER
  CONTENT_ISSUE
  ISSUE_COMMENT
  SUBSURVEY_ACTIVITY
  USER_PROGRESS
}

enum Channel {
  IN_APP
  EMAIL
  WHATSAPP
}

model Avatar {
  id       String @id @default(uuid())
  publicId String
  url      String
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
}

model SurveyActivity {
  id   String @id @default(uuid())
  name String
  slug String @unique

  SubSurveyActivity SubSurveyActivity[]
}

model SubSurveyActivity {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  surveyActivityId String
  surveyActivity   SurveyActivity @relation(fields: [surveyActivityId], references: [id])
  startDate        DateTime
  endDate          DateTime
  targetSample     Int
  sampleType       String
  activityType     String

  UserProgress UserProgress[]
  SuratTugas   JobLetter[]

  SubmitSPJ SubmitSPJ[]

  IssueComment IssueComment[]

  ContentIssue ContentIssue[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone_number String
  address      String?
  password     String
  role         Role     @default(User)
  avatar       Avatar?
  limit_bill   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  UPUser    UserProgress[] @relation("UserProgress_User")
  JobLetter JobLetter[]
  SubmitSPJ SubmitSPJ[]

  IssueComment IssueComment[]

  ContentIssue ContentIssue[]

  UpSuperVisor UserProgress[] @relation("UserProgress_Supervisor")

  NotificationR Notification[] @relation("Notification_Recipient")

  NotificationA Notification[] @relation("Notification_Actor")
}

model ContentIssue {
  id                  String            @id @default(uuid())
  content             String
  issueStatus         IssueStatus       @default(Waiting)
  reporterId          String
  reporter            User              @relation(fields: [reporterId], references: [id])
  subSurveyActivityId String
  subSurveyActivity   SubSurveyActivity @relation(fields: [subSurveyActivityId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  IssueComment IssueComment[]
}

model IssueComment {
  id                  String            @id @default(uuid())
  message             String
  contentId           String
  content             ContentIssue      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  subSurveyActivityId String
  subSurveyActivity   SubSurveyActivity @relation(fields: [subSurveyActivityId], references: [id])
  createdAt           DateTime          @default(now())
}

model UserProgress {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation("UserProgress_User", fields: [userId], references: [id])
  superVisorId        String?
  supervisor          User?              @relation("UserProgress_Supervisor", fields: [superVisorId], references: [id])
  subSurveyActivityId String?
  subSurveyActivity   SubSurveyActivity? @relation(fields: [subSurveyActivityId], references: [id], onDelete: Cascade)
  totalAssigned       Int                @default(0)
  submitCount         Int                @default(0)
  approvedCount       Int                @default(0)
  rejectedCount       Int                @default(0)
  blockCount          String?
  lastUpdated         DateTime           @updatedAt
  districtId          String?
  district            District?          @relation(fields: [districtId], references: [id])
  villageName         String?
  travelBill          String?

  samples UserSample[]
}

model UserSample {
  id             String       @id @default(uuid())
  userProgressId String
  userProgress   UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  nus            String
  identity       String
  cacahStatus    CacahStatus  @default(Belum_Cacah)
  approvalStatus AgreeState   @default(Menunggu)
  geoLat         Float?
  geoLng         Float?
  geoCapturedAt  DateTime?
  photoPath      String?
  photoCapturedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userProgressId, nus])
}

model District {
  id   String @id @default(uuid())
  city String
  name String

  UserProgress UserProgress[]
}

model JobLetter {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id])
  subSurveyActivityId   String
  subSurveyActivity     SubSurveyActivity @relation(fields: [subSurveyActivityId], references: [id])
  region                String
  submitDate            DateTime?
  agreeState            AgreeState        @default(Menunggu)
  approveDate           DateTime?
  rejectNote            String?
  eviLetterPath         String?
  eviLetterOriginalName String?
  eviLetterMimeType     String?
  eviLetterSize         Int?
  eviFieldUrl           String?
  eviSTUrl              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model SubmitSPJ {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  subSurveyActivityId String
  subSurveyActivity   SubSurveyActivity @relation(fields: [subSurveyActivityId], references: [id])
  submitState         AgreeState        @default(Menunggu)
  submitDate          DateTime          @default(now())
  approveDate         DateTime?
  verifyNote          String?
  eviDocumentPath     String?
  eviOriginalName     String?
  eviMimeType         String?
  eviSize             Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("Notification_Recipient", fields: [recipientId], references: [id])
  actorId     String?
  actor       User?            @relation("Notification_Actor", fields: [actorId], references: [id])
  type        NotificationType
  targetType  TargetType
  targetId    String
  title       String
  body        String?
  metadata    Json?
  channel     Channel          @default(IN_APP) // IN_APP/EMAIL/WHATSAPP, dll (opsional)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
}

